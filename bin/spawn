#!/usr/bin/env bash
# spawn <verb> [id] [extra context...]
#
# Creates a tmux window running a /sl-* slash command as a detached Claude Code
# session, so it self-registers in the Claude app (needs Remote Control enabled
# for all sessions). Invoked by dispatch-listener, or by hand over ssh/mosh.
# Nothing here depends on an interactive shell rc.
#
#   spawn implement 1234
#   spawn implement 1234 stack on the parent PR
#   spawn review 3771
#   spawn status
#
# Config comes from ~/.config/clanker/env (CLANKER_ENV to override):
#   CLANKER_REPO, CLANKER_TMUX_SESSION, CLANKER_GH_REPO, CLAUDE_BIN
set -euo pipefail

ENV_FILE="${CLANKER_ENV:-$HOME/.config/clanker/env}"
# shellcheck disable=SC1090
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"

REPO="${CLANKER_REPO:?set CLANKER_REPO in $ENV_FILE}"
SESSION="${CLANKER_TMUX_SESSION:-work}"
GH_REPO="${CLANKER_GH_REPO:-slate-technologies/slate}"

# Dispatched sessions start unattended, so `manual` (the CLI default) means they
# sit waiting on a keystroke nobody is at the box to give. `auto` is the point of
# the pipeline. Set empty to inherit the CLI default; `bypassPermissions` exists
# but don't — the whole permission model here is "allowlist in the target repo,
# approve the rest from the phone".
PERM_MODE="${CLANKER_PERMISSION_MODE-auto}"

EX_SKIP=3   # window already exists — a no-op, not a failure

usage() {
  cat >&2 <<'EOF'
usage: spawn <verb> [id] [extra context...]

Every id is a TICKET number — the number you have in front of you. For the
verbs whose slash command wants a PR, the ticket is resolved to its PR first.

  implement|ship 5506   -> /sl-ship SLATE-5506
  plan           5506   -> /sl-plan SLATE-5506
  style          5506   -> /sl-style SLATE-5506
  cleanup        5506   -> /sl-cleanup SLATE-5506
  review         5506   -> /sl-review <url of the PR for SLATE-5506>
  continue|revise 5506  -> /sl-revise <PR for SLATE-5506>
  status                -> /sl-status                (no id)
  new|session [text...]  -> bare claude session in the repo

A number with no PR referencing it is passed through as a literal PR number.
EOF
  exit 64
}

[[ $# -ge 1 ]] || usage
verb="$1"; shift

# Whitelisted verbs only — this is remote code execution by design, so the arg
# surface stays closed: known verb + numeric id + free-text tail. Each verb
# answers to both the intent word and its command's own name, so you never have
# to recall which vocabulary this wants.
#
# idstyle matters: ticket verbs are keyed by SLATE-N, review/revise by PR
# number. Those are different id spaces and must not share validation.
case "$verb" in
  implement|ship)  act=ship;    slash="/sl-ship";    idstyle=ticket ;;
  plan)            act=plan;    slash="/sl-plan";    idstyle=ticket ;;
  style)           act=style;   slash="/sl-style";   idstyle=ticket ;;
  cleanup)         act=cleanup; slash="/sl-cleanup"; idstyle=ticket ;;
  review)          act=review;  slash="/sl-review";  idstyle=prurl  ;;  # full URL
  continue|revise) act=revise;  slash="/sl-revise";  idstyle=pr     ;;
  status)          act=status;  slash="/sl-status";  idstyle=none   ;;
  # Bare session in the repo, no slash command. Any trailing text becomes the
  # opening prompt: `new look at the flaky auth test`.
  new|session)     act=new;     slash="";            idstyle=none   ;;
  *) echo "spawn: unknown verb '$verb'" >&2; usage ;;
esac

# `new` is the one verb you'd deliberately run twice — it's a blank session, not
# a claim on a work item — so it suffixes instead of hitting the guard below.
dedupe=skip
[[ "$act" == new ]] && dedupe=suffix

# Window name is <action>-<number>, e.g. ship-1234, review-3771. Keyed on the
# action too, not the id alone: review and revise share the PR id space, and
# reviewing a PR then revising it is an ordinary sequence that must not trip
# the idempotency guard. It doubles as the session name in the Claude app, so
# it has to say what the session is doing, not just which number it concerns.
gh_bin="$(command -v gh || true)"
[[ -x "$gh_bin" ]] || gh_bin=""

# Ticket numbers and PR numbers are different id spaces that look identical.
# In slate they don't even overlap yet — tickets are ~5500, PRs ~3900 — so
# `continue 5506` meant `/sl-revise 5506`, a PR that does not exist. Silent,
# because the session starts fine and only the agent discovers there's nothing
# there. One day the ranges WILL cross and it stops being silent: it becomes
# revising a real, unrelated PR.
#
# You dispatch by ticket, because that's the number you have in front of you.
# So ask GitHub which PR carries the ticket. Fall back to using the number
# literally when nothing matches, so a genuine PR number still works.
# `gh --search` alone is far too loose to trust here: it tokenises, so
# "SLATE-999999" happily returns a PR that merely mentions SLATE. Anchor the
# search to the title AND re-check each hit against the exact ticket, or this
# silently dispatches at whatever PR the search felt like returning.
# Prefer open PRs, then the newest — a ticket can have a stack.
resolve_pr() {
  local n="$1" found=""
  if [[ -n "$gh_bin" ]]; then
    found="$(timeout 25 "$gh_bin" pr list --repo "$GH_REPO" --search "SLATE-$n in:title" \
               --state all --limit 10 --json number,state,title 2>/dev/null \
             | jq -r --arg t "SLATE-$n" '
                 map(select(.title | test("\\b" + $t + "\\b"; "i")))
                 | (map(select(.state == "OPEN")) | select(length > 0)) // .
                 | max_by(.number).number // empty' 2>/dev/null)"
  fi
  if [[ "$found" =~ ^[0-9]+$ ]]; then
    echo "$found"
  else
    # No PR carries this ticket. Use the number as given: it may genuinely be a
    # PR number, and guessing is worse than being literal.
    echo "$n"
  fi
}

if [[ "$idstyle" == none ]]; then
  id=""; label="$act"
else
  [[ $# -ge 1 ]] || usage
  raw="${1#SLATE-}"; raw="${raw#slate-}"; raw="${raw#\#}"
  shift
  [[ "$raw" =~ ^[0-9]{1,6}$ ]] || { echo "spawn: bad id '$raw' (digits only)" >&2; exit 64; }
  # Label by what you typed, not what it resolved to: you dispatched 5506 and
  # that's the number you'll look for in the list.
  label="$act-$raw"
  case "$idstyle" in
    ticket) id="SLATE-$raw" ;;
    prurl)  id="https://github.com/$GH_REPO/pull/$(resolve_pr "$raw")" ;;
    pr)     id="$(resolve_pr "$raw")" ;;
  esac
fi

extra="$*"
if [[ -n "$slash" ]]; then
  prompt="$slash${id:+ $id}${extra:+ — $extra}"
else
  prompt="$extra"   # bare session: the tail IS the prompt, and may be empty
fi

[[ -d "$REPO" ]] || { echo "spawn: repo not found: $REPO" >&2; exit 66; }

# Resolve claude by absolute path, never by PATH alone. The systemd user unit
# runs with a PATH that has no ~/.local/bin, so a bare `claude` fails there —
# intermittently, because a window inherits the env of whichever process
# created the tmux server, so it works iff an interactive shell got there first.
claude_bin="${CLAUDE_BIN:-}"
if [[ -z "$claude_bin" ]]; then
  for cand in "$HOME/.local/bin/claude" "$(command -v claude || true)"; do
    [[ -n "$cand" && -x "$cand" ]] && { claude_bin="$cand"; break; }
  done
fi
[[ -n "$claude_bin" && -x "$claude_bin" ]] \
  || { echo "spawn: claude not found (set CLAUDE_BIN in $ENV_FILE)" >&2; exit 127; }

agents_json() { timeout 20 "$claude_bin" agents --json 2>/dev/null; }

# Is a session with this name alive right now? `claude agents --json` is the
# source of truth — it knows about background agents, which have no tmux window
# and no predictable process name to grep for.
agent_alive() {
  agents_json | jq -e --arg n "$1" 'any(.[]; .name == $n)' >/dev/null 2>&1
}

# Idempotency guard: one window per id. ntfy delivers at least once, and the
# listener replays `since=10m` on restart, so a redelivered message must not
# spawn a second session. Deliberately a hard skip, not a -2 suffix: the
# listener is the reason this exists, and silent double-spawn is the worse bug.
# Only a *live* session blocks a re-dispatch. A finished agent leaves its name
# free, so re-running completed work just works instead of reporting "Already
# up" about something that ended half an hour ago.
if agent_alive "$label"; then
  if [[ "$dedupe" == skip ]]; then
    echo "session $label is already running; skipping" >&2
    exit "$EX_SKIP"
  fi
  # `new` is a blank session, not a claim on a work item — running two is
  # legitimate. Suffix is -N, never .N, to stay tmux-target-safe if attached.
  n=2
  while agent_alive "$label-$n"; do n=$((n + 1)); done
  label="$label-$n"
fi

# Name the session twice over, both matching the tmux window:
#   -n               sets `name` in ~/.claude/sessions/<pid>.json
#   --remote-control sets the app-side name
# Without these it registers under a derived name (slate-a8, slate-e7) and every
# concurrent session looks identical in the app — indistinguishable from "it
# never showed up". Use the `=` form: --remote-control's value is optional, so a
# space-separated name risks the parser swallowing the prompt arg.
#
# printf %q on every interpolation — the free-text tail is user input and an
# apostrophe ("don't rebase") would otherwise break out of the quoting.
# -d so an attached client doesn't lose focus; `exec $SHELL` so the window
# survives claude exiting and the scrollback is there for a post-mortem.
args=(-n "$label" --remote-control="$label" --bg)
[[ -n "$PERM_MODE" ]] && args+=(--permission-mode "$PERM_MODE")
# Omit the prompt arg entirely when empty — an empty string is still an
# argument, and `claude ''` is not the same as `claude`.
[[ -n "$prompt" ]] && args+=("$prompt")

# Launch OUTSIDE this process's cgroup. --bg agents are children of whoever
# started them, so one dispatched by the systemd unit would be killed the next
# time the listener restarts — `make restart` would silently take out every
# running agent. A transient scope makes them independent of us.
cd "$REPO"
if command -v systemd-run >/dev/null && [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  systemd-run --user --scope --quiet --collect \
    --unit="clanker-agent-$label-$$" \
    "$claude_bin" "${args[@]}" >/dev/null 2>&1 \
    || "$claude_bin" "${args[@]}" >/dev/null 2>&1
else
  "$claude_bin" "${args[@]}" >/dev/null 2>&1
fi

# Record what was dispatched. The board is built from open PRs, but a ticket
# you've only just started has no PR yet and would be invisible for the twenty
# minutes that matters most — right after you kicked it off from a train.
if [[ -n "${raw:-}" ]]; then
  hist="${XDG_STATE_HOME:-$HOME/.local/state}/clanker/dispatched.jsonl"
  mkdir -p "$(dirname "$hist")"
  printf '{"at":%s,"verb":%s,"ticket":%s,"label":%s}\n' \
    "$(date +%s)" "\"$act\"" "\"$raw\"" "\"$label\"" >> "$hist"
  # Bound it; this is a recency window, not an archive.
  if [[ "$(wc -l < "$hist" 2>/dev/null || echo 0)" -gt 400 ]]; then
    tail -n 200 "$hist" > "$hist.tmp" && mv "$hist.tmp" "$hist"
  fi
fi

# Say what the ticket resolved to. The label is the ticket you typed, so
# without this line there's nothing anywhere that records which PR the session
# was actually pointed at.
if [[ "$idstyle" =~ ^(pr|prurl)$ && "${id##*/}" != "$raw" ]]; then
  echo "spawned [$label] SLATE-$raw -> PR ${id##*/}"
else
  echo "spawned [$label] ${prompt:-(bare session)}"
fi
