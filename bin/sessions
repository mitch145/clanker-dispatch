#!/usr/bin/env bash
# sessions [list|stop <name>] — report or stop dispatched Claude sessions.
#
# Source of truth is `claude agents --json`, not tmux: dispatched sessions are
# background agents with no window and no greppable process name. It lists
# interactive sessions too, so what you see here is what the Claude app shows.
# Output is kept short — it goes into a push notification.
set -uo pipefail

ENV_FILE="${CLANKER_ENV:-$HOME/.config/clanker/env}"
# shellcheck disable=SC1090
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"

CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
[[ -x "$CLAUDE_BIN" ]] || CLAUDE_BIN="$(command -v claude || true)"
[[ -x "$CLAUDE_BIN" ]] || { echo "claude not found"; exit 127; }

agents() { timeout 25 "$CLAUDE_BIN" agents --json 2>/dev/null; }

case "${1:-list}" in
  list)
    json="$(agents)"
    [[ -n "$json" ]] || { echo "could not read agent list"; exit 1; }
    # Phase, not `.status` alone: a finished background session has no `.status`
    # field at all, so testing it reports "idle" for something that ended hours
    # ago, and for one that's blocked waiting on a human. `.status` being absent
    # is exactly the liveness test. See bin/clanker-ui for the full record shapes.
    #   ! blocked (wants you)   ▶ busy   ○ idle
    # Only live sessions are listed — this goes into a push notification, and
    # finished ones would push the interesting row off the screen.
    printf '%s' "$json" | jq -r '
      map(select(has("status"))) as $a
      | if ($a | length) == 0 then "nothing running"
        else
          ( $a
            | map(. + {ph: (if .state == "blocked" then "blocked" else (.status // "idle") end)})
            | map(. + {rank: (if .ph == "blocked" then 0 elif .ph == "busy" then 1 else 2 end)})
            | sort_by(.rank, .name)
            | map(
                (if .ph == "blocked" then "! " elif .ph == "busy" then "▶ " else "○ " end)
                + (.name // "(unnamed \(.sessionId[0:8]))")
                + (if .kind == "background" then "" else " (interactive)" end)
              ) | join("\n") )
          + "\n"
          + (($a | map(select(.state == "blocked")) | length | tostring) + " blocked, "
            + ($a | map(select(.status == "busy")) | length | tostring) + " busy, "
            + ($a | map(select(.status != "busy" and .state != "blocked")) | length | tostring) + " idle")
        end'
    ;;
  stop)
    name="${2:-}"
    [[ -n "$name" ]] || { echo "usage: sessions stop <name>"; exit 64; }
    rec="$(agents | jq -r --arg n "$name" '.[] | select(.name == $n) | "\(.sessionId)\t\(.kind)"' | head -1)"
    [[ -n "$rec" ]] || { echo "no session named $name"; exit 1; }
    id="${rec%%$'\t'*}"; kind="${rec##*$'\t'}"
    # `claude stop` wants the short id — the full sessionId UUID is rejected
    # with "No job matching". And it only stops background sessions; an
    # interactive one is someone at a keyboard, so say so rather than failing.
    [[ "$kind" == background ]] || { echo "$name is interactive — stop it where it's attached"; exit 1; }
    timeout 25 "$CLAUDE_BIN" stop "${id:0:8}" >/dev/null 2>&1 \
      && echo "stopped $name" || echo "could not stop $name"
    ;;
  *)
    echo "usage: sessions [list|stop <name>]" >&2; exit 64 ;;
esac
