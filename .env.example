# Copy to ~/.config/clanker/env and edit. chmod 600 it.
# Consumed by dispatch-listener, spawn, and the systemd unit (EnvironmentFile).

# ntfy access token (ntfy.sh -> Account -> Access tokens)
NTFY_TOKEN=tk_replace_me

# Full topic URL. Generate the suffix: openssl rand -hex 8
# Topic name is the credential on free tier — keep it secret.
NTFY_TOPIC_URL=https://ntfy.sh/clanker-dispatch-REPLACE_ME

# Repo the sessions run in (slash commands live in its .claude/commands)
CLANKER_REPO=/mnt/c/projects/slate/slate

# tmux session name that holds spawned windows
CLANKER_TMUX_SESSION=work

# Permission mode for dispatched sessions. `manual` (the CLI default) makes an
# unattended session wait on a keystroke nobody is there to give.
# choices: auto | acceptEdits | manual | plan | dontAsk | bypassPermissions
# Leave unset for `auto`; set empty to inherit the CLI default.
CLANKER_PERMISSION_MODE=auto

# owner/repo used to build PR URLs for the `review` verb
CLANKER_GH_REPO=slate-technologies/slate

# Optional: absolute path to the claude binary. spawn resolves
# ~/.local/bin/claude then PATH; set this only if yours lives elsewhere.
#CLAUDE_BIN=/home/mitch/.local/bin/claude
